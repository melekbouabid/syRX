# Fallback for builds whose context is the repository root. The images of this repository
# each have their own allow-list next to their Dockerfile (<Dockerfile>.dockerignore), which
# replaces this file: app/backend/Dockerfile.dockerignore.
# Never send secrets, collected data, models or local environments to a build.
.env
.env.*
data/
models/
weights/
.git/
.dvc/cache/
**/.venv/
**/.venv-*/
**/node_modules/
**/__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/
